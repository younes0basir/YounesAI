{
  "expo": {
    "name": "YounesAI",
    "slug": "younesai-mobile",
    "scheme": "younesai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.younesai.mobile"
    },
    "android": {
      "package": "com.younesai.mobile",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": ["RECORD_AUDIO", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow YounesAI to unlock with Face ID."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow YounesAI to access your microphone for voice commands."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow YounesAI to use your location for place-based context."
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
