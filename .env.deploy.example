# Health checks after deploy (port 80 = nginx → backend :3000)
PUBLIC_HEALTH_URL=http://84.8.220.241/api/health

# One-time: open TCP 80 in Oracle Cloud → VCN → Security List → Ingress Rules
# (port 3000 works from desktop but many phones block outbound :3000 on mobile data)
