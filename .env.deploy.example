# Copy to .env.deploy (gitignored) and adjust paths.
# Used by scripts/deploy-oracle.ps1 and scripts/deploy.sh

ORACLE_HOST=opc@84.8.220.241
ORACLE_KEY=C:\Users\ken\Downloads\ssh-key-2026-08-28.key
ORACLE_APP_DIR=/home/opc/YounesAI
