PORT=3000

# Local Postgres (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=your_database_name

# Deployment (Render/Railway) — set DATABASE_URL instead of the DB_* vars.
# Use Render Postgres, Neon, or Supabase (connection string with SSL). Render
# injects DATABASE_URL automatically for its Postgres service.
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

JWT_SECRET=your_jwt_secret_here

# CORS — comma-separated list of allowed frontend origins.
# On Render, set the same value in the dashboard so your deployed frontend works.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8081

# AI Provider Keys (for multi-agent system)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NVIDIA NIM chat/embed API — all chat/embed agents (integrate.api.nvidia.com)
# Shared key used by ALL NIM agents unless overridden per-agent below.
NVIDIA_NIM_API_KEY=nvapi-your_nim_key_here
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Per-agent overrides (optional).
# Each agent can have its own key, base URL, and model via env vars:
#   NVIDIA_<AGENT>_API_KEY   — distinct key for that agent only
#   NVIDIA_<AGENT>_BASE_URL  — distinct endpoint for that agent only
#   NVIDIA_<AGENT>_MODEL     — distinct model for that agent only
# If an override is not set, it falls back to the shared NVIDIA_NIM_* value above.
#
# NVIDIA_ORCHESTRATOR_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_TASK_API_KEY=nvapi-a-different-key-for-task-only
# NVIDIA_TASK_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_EVENT_API_KEY=nvapi-a-different-key-for-event-only
# NVIDIA_EVENT_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_PLACE_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_FILE_MODEL=meta/llama-3.1-70b-instruct
# NVIDIA_MEMORY_MODEL=baai/bge-large-en-v1.5
# NVIDIA_GENERAL_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_DESKTOP_MODEL=meta/llama-3.1-8b-instruct
#
# To add a new agent, add one line in config.js:
#   custom: nvidiaProfile('custom', 'meta/llama-3.1-8b-instruct'),
# then optionally set NVIDIA_CUSTOM_API_KEY / NVIDIA_CUSTOM_MODEL in .env.

# NVIDIA image generation (FLUX) — separate key from NIM
# NVIDIA_IMAGE_API_KEY=nvapi-your_image_key_here

# AI Service API Keys (never commit real keys here)
# If you previously used the real keys that were in this file, rotate them in the provider dashboards.

# Optional: set to true to prepend agent responses with a "Source check" provenance line
# SHOW_AGENT_SOURCES=false

# Frontend URL (for Gmail OAuth callback redirect)
FRONTEND_URL=http://localhost:5173

# Gmail OAuth (Google Cloud Console)
# Template only — put real values in Render env vars, never commit them.
GOOGLE_GMAIL_CLIENT_ID=YOUR_NUMBER.apps.googleusercontent.com
GOOGLE_GMAIL_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# OAuth token encryption at rest (64 hex chars = 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Email AI — classification, summarization, chat (agents/email/)
# Falls back to NVIDIA_NIM_API_KEY / NVIDIA_NIM_BASE_URL if not set.
NVIDIA_EMAIL_API_KEY=nvapi-your_email_key_here
NVIDIA_EMAIL_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMAIL_MODEL=nvidia/nemotron-3-super-120b-a12b

# Gmail sync tuning
# GMAIL_SYNC_INTERVAL_MINUTES=5
# GMAIL_MAX_ACCOUNTS_PER_USER=2
