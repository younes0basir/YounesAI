PORT=3000

# Local Postgres (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=your_database_name

JWT_SECRET=your_jwt_secret_here

# AI Service API Keys
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NVIDIA image generation (FLUX) — separate service from NIM
NVIDIA_IMAGE_API_KEY=nvapi-your_image_key_here
# Legacy fallback for image gen if NVIDIA_IMAGE_API_KEY is unset
NVIDIA_API_KEY=nvapi-your_legacy_nvidia_key_here
# Last-resort NVIDIA key when primary keys expire or are unset (NIM + image gen)
NVIDIA_SAFETY_API_KEY=nvapi-your_backup_key_here

# NVIDIA NIM chat/embed API — shared key for all NIM agents
NVIDIA_NIM_API_KEY=nvapi-your_nim_key_here
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Per-agent overrides (optional) — uncomment to give an agent its own key/model/endpoint.
# Pattern: NVIDIA_<AGENT>_API_KEY / NVIDIA_<AGENT>_BASE_URL / NVIDIA_<AGENT>_MODEL
# Falls back to the shared NVIDIA_NIM_* values above when not set.
# NVIDIA_ORCHESTRATOR_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_TASK_API_KEY=nvapi-per-agent-key-for-task-only
# NVIDIA_TASK_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_EVENT_API_KEY=
# NVIDIA_EVENT_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_PLACE_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_FILE_MODEL=meta/llama-3.1-70b-instruct
# NVIDIA_MEMORY_MODEL=baai/bge-large-en-v1.5
# NVIDIA_GENERAL_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_DESKTOP_MODEL=meta/llama-3.1-8b-instruct

# Gmail OAuth (Google Cloud Console)
GOOGLE_GMAIL_CLIENT_ID=YOUR_NUMBER.apps.googleusercontent.com
GOOGLE_GMAIL_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# OAuth token encryption at rest (64 hex chars = 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Neon Postgres — preferred for local + cloud (Render, Oracle VM, Railway, etc.)
# When DATABASE_URL is set, DB_* vars above are ignored.
NEON_BRANCH=main
DATABASE_URL=postgresql://user:pass@ep-your-project-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-your-project.region.aws.neon.tech/neondb?sslmode=require

# CORS — comma-separated list of allowed frontend origins.
# Add your public IP/domain when serving the frontend over the internet, e.g.:
# CORS_ORIGIN=http://localhost:5173,http://YOUR_PUBLIC_IP:5173,https://yourdomain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8081

# Frontend URL (Gmail OAuth redirect after callback)
# FRONTEND_URL=http://localhost:5173
# Public deploy example:
# FRONTEND_URL=http://YOUR_PUBLIC_IP:5173

# Email AI — classification, summarization, chat (agents/email/)
# Falls back to NVIDIA_NIM_API_KEY / NVIDIA_NIM_BASE_URL if not set.
NVIDIA_EMAIL_API_KEY=nvapi-your_email_key_here
NVIDIA_EMAIL_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMAIL_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: set to true to prepend agent responses with a "Source check" provenance line
# SHOW_AGENT_SOURCES=false

# Gmail sync tuning
# GMAIL_SYNC_INTERVAL_MINUTES=5
# GMAIL_MAX_ACCOUNTS_PER_USER=2

# Subscription plans (MVP — manual admin assignment)
# ADMIN_API_KEY=your_admin_secret
# PLAN_STARTER_AI_DAILY=10
# PLAN_PRO_AI_DAILY=100
# PLAN_PLATINUM_AI_DAILY=500
