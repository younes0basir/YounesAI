# Must include the /api prefix — backend mounts all routes under /api
# Oracle VM example:
# VITE_API_URL=http://84.8.220.241:3000/api
VITE_API_URL=http://84.8.220.241:3000/api
VITE_API_URL_LOCAL=http://localhost:3000/api
VITE_GEOAPIFY_KEY=your_geoapify_api_key_here
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here
